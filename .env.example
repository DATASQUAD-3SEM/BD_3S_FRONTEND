# Copie para ".env" SE precisar mudar algo (normalmente NAO precisa).
# Endereco do backend Spring Boot. O Vite repassa /api/* para ele (ver vite.config.ts).
BACKEND_URL=http://localhost:8080

# So usado pelo "npm run dev:full": pasta do repositorio do backend (onde esta o mvnw).
# Padrao: ../nexus (repositorios lado a lado).
BACKEND_DIR=../nexus
